q=part(.24,.55,.30,mat,y,z);q.rotation.x=ang;for(let yy=-.16;yy<.18;yy+=.09)box(.205,.018,.315,dark,x,y+yy,z-.005,gun);return q};
 const magazine=(y,z,w=.22,h=.48,d=.32,ang=.08)=>{let q=part(w,h,d,metal,y,z);q.rotation.x=ang;box(w*.72,.035,d*1.03,dark,x,y+h*.22,z,gun);return q};
 const rail=(z,len=.7,y=-.095)=>{box(.24,.045,len,dark,x,y,z,gun);for(let dz=-len*.42;dz<len*.43;dz+=.09)box(.27,.018,.025,metal,x,y-.028,z+dz,gun)};
 const muzzleBrake=(z,rad=.105)=>{cyl(rad,.22,dark,x,-.235,z);for(const dx of [-.065,.065])box(.035,.08,.08,M(0x050606,.25),x+dx,-.235,z-.01,gun)};
 const optic=(z,y=-.025,scale=1)=>{cyl(.11*scale,.48*scale,dark,x,y,z);for(const zz of [-.18,.18]){let r=new THREE.Mesh(new THREE.TorusGeometry(.125*scale,.025*scale,8,16),metal);r.rotation.x=Math.PI/2;r.position.set(x,y,z+zz*scale);gun.add(r)}box(.20*scale,.055,.14*scale,dark,x,y+.12*scale,z,gun)};
 const frontSight=(z,y=-.08)=>{box(.035,.17,.04,dark,x,y,z,gun);box(.15,.035,.04,dark,x,y-.075,z,gun)};
 const stock=(z,mat=poly)=>{let s=part(.36,.42,.70,mat,-.42,z);s.rotation.x=-.12;box(.38,.46,.11,rubber,x,-.42,z+.35,gun);return s};

 if(weapon==='rifle'){
   // Modern tactical rifle: stock, upper/lower receiver, curved magazine, handguard and optic.
   stock(-.34);part(.36,.30,1.02,metal,-.30,-1.05);part(.32,.28,.78,poly,-.28,-1.78);
   grip(-.62,-.75,-.28);magazine(-.62,-1.18,.23,.54,.34,.13);
   cyl(.062,1.18,steel,x,-.235,-2.70);muzzleBrake(-3.28,.10);rail(-1.46,1.35,-.095);
   // vented handguard slots
   for(let zz=-1.52;zz>-2.14;zz-=.16){for(const sx of [-.155,.155])box(.025,.08,.09,dark,x+sx,-.27,zz,gun)}
   box(.15,.08,.34,dark,x,-.055,-1.22,gun);optic(-1.50,-.015,.78);frontSight(-2.42,-.11);
   // ejection port / charging handle
   box(.015,.115,.34,M(0x080909,.18),x+.19,-.27,-1.12,gun);box(.24,.045,.07,dark,x,-.16,-.57,gun);
 }else if(weapon==='smg'){
   // Compact SMG with collapsible stock, short barrel and box magazine.
   part(.38,.34,.92,metal,-.30,-1.05);part(.34,.30,.48,poly,-.29,-1.58);grip(-.62,-.82,-.18);
   magazine(-.67,-1.18,.20,.62,.26,-.05);cyl(.06,.58,steel,x,-.245,-1.94);muzzleBrake(-2.23,.095);rail(-1.20,.86,-.10);
   for(const sx of [-.18,.18])cyl(.027,.70,steel,x+sx,-.30,-.45);box(.43,.33,.10,rubber,x,-.31,-.08,gun);
   optic(-1.18,-.045,.60);frontSight(-1.78,-.10);box(.018,.12,.26,dark,x+.20,-.28,-.90,gun);
 }else if(weapon==='shotgun'){
   // Pump shotgun with twin tubes, ribbed fore-end, receiver and shoulder stock.
   stock(-.42,wood);part(.37,.30,.86,metal,-.30,-1.10);grip(-.61,-.72,-.30,wood);
   cyl(.058,1.72,steel,x,-.235,-2.42);cyl(.052,1.38,dark,x,-.37,-2.26);muzzleBrake(-3.26,.075);
   let pump=part(.46,.31,.62,wood,-.32,-1.82);for(let zz=-2.04;zz<-1.55;zz+=.085)box(.49,.035,.035,dark,x,-.31,zz,gun);
   box(.055,.045,1.55,dark,x,-.11,-2.27,gun);frontSight(-3.02,-.11);
   box(.02,.12,.28,dark,x+.20,-.30,-1.05,gun);
 }else if(weapon==='pistol'){
   // Semi-auto pistol: distinct slide/frame, exposed barrel, sights and textured grip.
   part(.30,.20,.90,M(0x343a3d,.27),-.18,-1.02);part(.27,.20,.64,poly,-.34,-.88);
   let pg=grip(-.61,-.72,-.18,rubber);pg.scale.x=.92;pg.scale.z=.86;
   cyl(.043,.55,steel,x,-.205,-1.38);box(.17,.025,.30,dark,x,-.58,-.72,gun);
   // ejection port and slide serrations
   box(.12,.018,.22,M(0x111315,.18),x+.08,-.075,-.98,gun);
   for(let zz=-.72;zz>-.91;zz-=.045)box(.315,.035,.018,dark,x,-.17,zz,gun);
   box(.07,.055,.05,dark,x,-.06,-.62,gun);box(.045,.075,.04,M(0xd8d8c7,.35),x,-.055,-1.48,gun);
   const guard=new THREE.Mesh(new THREE.TorusGeometry(.105,.025,8,16,Math.PI*1.15),poly);guard.rotation.z=Math.PI;guard.position.set(x,-.46,-.98);gun.add(guard);
 }else if(weapon==='dmr'){
   // Long-range marksman rifle with extended handguard, scope and heavier barrel.
   stock(-.36,M(0x3f342b,.68));part(.36,.31,1.18,metal,-.30,-1.18);part(.32,.28,1.12,poly,-.28,-2.10);
   grip(-.63,-.80,-.25);magazine(-.64,-1.30,.23,.52,.34,.08);cyl(.066,1.65,steel,x,-.235,-3.18);muzzleBrake(-4.0,.11);
   rail(-1.72,1.62,-.095);optic(-1.66,-.015,1.0);frontSight(-3.22,-.10);
   for(let zz=-1.72;zz>-2.55;zz-=.17){for(const sx of [-.15,.15])box(.025,.075,.10,dark,x+sx,-.27,zz,gun)}
   box(.018,.12,.36,dark,x+.20,-.28,-1.17,gun);box(.20,.045,.08,dark,x,-.14,-.56,gun);
 }
 // Shared trigger/controls and small metallic fasteners.
 if(weapon!=='pistol'){
   const guard=new THREE.Mesh(new THREE.TorusGeometry(.11,.025,8,16,Math.PI),dark);guard.rotation.z=Math.PI;guard.position.set(x,-.48,weapon==='shotgun'?-1.02:-.94);gun.add(guard);
 }
 for(const dx of [-.12,.12]){let pin=new THREE.Mesh(new THREE.CylinderGeometry(.018,.018,.025,8),brass);pin.rotation.z=Math.PI/2;pin.position.set(x+dx,-.29,weapon==='pistol'?-.88:-1.0);gun.add(pin)}
 const muzzleZ=weapon==='shotgun'?-3.38:weapon==='smg'?-2.36:weapon==='pistol'?-1.56:weapon==='dmr'?-4.13:-3.40;
 muzzle=new THREE.PointLight(0xffb35a,0,4);muzzle.position.set(x,-.23,muzzleZ);gun.add(muzzle);
}

function setWeapon(w){if(!unlocked[w])return;stopAuto();weapon=w;rebuildGun();weaponNameEl.textContent=wd().name;show(wd().name);ui()}
function weaponSound(){
 if(weapon==="pistol"){noise(.075,.38,1100);tone(125,.055,"square",.13);return}
 if(weapon==="dmr"){noise(.13,.62,1450);tone(78,.10,"square",.19);return}if(weapon==="shotgun"){noise(.16,.8,1800);tone(58,.22,"square",.34)}else if(weapon==="smg"){noise(.07,.5,2300);tone(105,.09,"square",.18)}else gunS()}
function diff(w){return{count:6+(w-1)*3,hp:3+Math.floor((w-1)*.7),speed:1.15+(w-1)*.12,attack:Math.max(.32,.86-(w-1)*.04),damage:10+Math.floor((w-1)/3)*2,strafe:Math.min(.78,(w-1)*.06),surge:Math.min(.95,(w-1)*.07)}}

function createLastZombieMarker(){
 const cv=document.createElement("canvas");cv.width=96;cv.height=96;const c=cv.getContext("2d");
 c.translate(48,48);
 c.fillStyle="rgba(255,60,60,.95)";
 c.beginPath();c.moveTo(0,-28);c.lineTo(23,0);c.lineTo(0,28);c.lineTo(-23,0);c.closePath();c.fill();
 c.strokeStyle="rgba(255,255,255,.95)";c.lineWidth=5;c.stroke();
 c.beginPath();c.arc(0,0,10,0,Math.PI*2);c.fillStyle="rgba(255,220,80,.95)";c.fill();
 const tx=new THREE.CanvasTexture(cv);tx.colorSpace=THREE.SRGBColorSpace;
 const mat=new THREE.SpriteMaterial({map:tx,transparent:true,depthTest:false,depthWrite:false});
 const spr=new THREE.Sprite(mat);spr.scale.set(1.35,1.35,1);spr.renderOrder=999;return spr
}







function makeZombie(x,z,i){
 let d=diff(wave),g=new THREE.Group(),scale=.86+rnd()*.05;
 const nightmareType=(()=>{const r=rnd();if(wave>=5&&r<.04)return "brute";if(wave>=4&&r<.08)return "splitjaw";if(wave>=3&&r<.14)return "crawler";if(wave>=3&&r<.22)return "twitch";return "normal"})();
 g.scale.set(scale,scale*(.99+rnd()*.02),scale);
 const bodyType=i%3;

 const skin=zombieTex([0x747b68,0x7b7868,0x687063,0x80776a][i%4],0),
       shirt=zombieTex([0x424848,0x4b443b,0x34424a,0x51493f,0x463d40][i%5],1),
       pants=zombieTex([0x24282b,0x34312e,0x2b3337][i%3],2),
       wound=M(0x59201c,.96),bone=M(0xd6cfbc,.78),dark=M(0x17191b,.90),shoe=M(0x1d1e20,.94);

 const shoulderOffset=(bodyType===0?.225:bodyType===2?.245:.235),hipOffset=(bodyType===0?.105:bodyType===2?.118:.11),
       hunchBias=.025+rnd()*.045,shoulderDrop=(rnd()-.5)*.03,limpSide=rnd()>.5?1:-1,armDrop=rnd()*.035;

 // One tapered torso and one pelvis = much cleaner human outline.
 let torso=taperedPrism(bodyType===0?.31:bodyType===2?.36:.335,bodyType===0?.245:bodyType===2?.285:.265,.55,.19,.16,shirt,0,1.35,0,g);
 let pelvis=taperedPrism(bodyType===0?.25:bodyType===2?.285:.265,bodyType===0?.225:bodyType===2?.255:.24,.20,.17,.16,pants,0,.91,0,g);
 let chest=torso,stomach=null;
 let jacket = null;
 if(i%2===0){ jacket=box(bodyType===0?.31:bodyType===2?.36:.335,.48,.19,M(i%3===0?0x31373d:i%3===1?0x45413a:0x3c4a46,.80),0,1.37,.005,g); jacket.rotation.z=(i%4===0?-.02:.02);} 

 let neck=new THREE.Mesh(new THREE.CylinderGeometry(.052,.061,.115,8),skin);neck.position.set(0,1.69,0);g.add(neck);
 let head=new THREE.Mesh(new THREE.BoxGeometry(.27,.31,.23),skin);head.position.set(0,1.88,-.002);head.scale.set(.78,1.00,.78);head.userData.isHead=true;g.add(head);
 let jaw=taperedPrism(.115,.100,.070,.090,.082,skin,0,-.120,-.010,head);jaw.rotation.x=.030;
 let mouth=box(.060,.007,.004,M(0x291414),0,-.118,-.121,head);

 // Flat face details: no cartoon eyeballs.
 for(const ex of [-.053,.053]){
   let socket=box(.034,.018,.004,M(0x241714,.72),ex,.022,-.116,head);
   let eye=box(.010,.005,.003,M(i%4===0?0xbcb89f:0x8a8b76,.68),ex,.022,-.120,head);
 }
 let nose=box(.020,.040,.012,skin,0,-.002,-.115,head);
 let browL=box(.050,.010,.004,dark,-.042,.052,-.114,head);browL.rotation.z=-.05;
 let browR=box(.050,.010,.004,dark,.042,.052,-.114,head);browR.rotation.z=.05;
 if(i%3!==0){let hair=box(.18,.035,.12,M(i%2?0x211c19:0x30271f,.92),0,.135,-.002,head);hair.rotation.x=-.02}

 // restrained facial injury
 if(i%3===0){let faceWound=box(.045,.050,.007,wound,-.085,-.005,-.157,head);faceWound.rotation.z=.18}
 if(i%5===2){let skullPatch=box(.052,.030,.006,bone,.070,.080,-.153,head);skullPatch.rotation.z=-.10}

 // shoulders
 let shoulderL=new THREE.Mesh(new THREE.SphereGeometry(.066,7,5),shirt);shoulderL.scale.set(1,.86,.90);shoulderL.position.set(-shoulderOffset,1.58,0);g.add(shoulderL);
 let shoulderR=shoulderL.clone();shoulderR.position.x=shoulderOffset;g.add(shoulderR);

 // Articulated arms: shoulder group -> elbow pivot -> forearm/hand.
 let armL=new THREE.Group(),armR=new THREE.Group();armL.position.set(-shoulderOffset,1.57,0);armR.position.set(shoulderOffset,1.57,0);g.add(armL);g.add(armR);
 let upperArmL=new THREE.Mesh(new THREE.CylinderGeometry(.052,.047,.29,8),skin);upperArmL.position.y=-.145;armL.add(upperArmL);
 let upperArmR=upperArmL.clone();armR.add(upperArmR);
 let sleeveL=new THREE.Mesh(new THREE.CylinderGeometry(.064,.066,.10,8),shirt);sleeveL.position.y=-.045;armL.add(sleeveL);let sleeveR=sleeveL.clone();armR.add(sleeveR);
 let elbowL=new THREE.Group(),elbowR=new THREE.Group();elbowL.position.set(0,-.29,0);elbowR.position.set(0,-.29,0);armL.add(elbowL);armR.add(elbowR);
 let elbowJointL=new THREE.Mesh(new THREE.SphereGeometry(.045,7,5),skin);elbowL.add(elbowJointL);let elbowJointR=elbowJointL.clone();elbowR.add(elbowJointR);
 let foreArmL=new THREE.Mesh(new THREE.CylinderGeometry(.046,.038,.27,8),skin);foreArmL.position.set(0,-.135,-.012);foreArmL.rotation.x=.08;elbowL.add(foreArmL);
 let foreArmR=foreArmL.clone();elbowR.add(foreArmR);
 let handL=new THREE.Mesh(new THREE.BoxGeometry(.052,.070,.075),skin);handL.position.set(0,-.285,-.035);handL.rotation.x=.10;elbowL.add(handL);let handR=handL.clone();elbowR.add(handR);

 // Articulated legs: hip group -> knee pivot -> calf/foot.
 let legL=new THREE.Group(),legR=new THREE.Group();legL.position.set(-hipOffset,.81,0);legR.position.set(hipOffset,.81,0);g.add(legL);g.add(legR);
 let thighL=new THREE.Mesh(new THREE.CylinderGeometry(.076,.068,.36,8),pants);thighL.position.y=-.18;legL.add(thighL);let thighR=thighL.clone();legR.add(thighR);
 let kneeL=new THREE.Group(),kneeR=new THREE.Group();kneeL.position.set(0,-.36,0);kneeR.position.set(0,-.36,0);legL.add(kneeL);legR.add(kneeR);
 let kneeJointL=new THREE.Mesh(new THREE.SphereGeometry(.056,7,5),pants);kneeJointL.scale.set(.94,.78,1);kneeL.add(kneeJointL);let kneeJointR=kneeJointL.clone();kneeR.add(kneeJointR);
 let calfL=new THREE.Mesh(new THREE.CylinderGeometry(.062,.052,.32,8),pants);calfL.position.set(0,-.16,-.004);kneeL.add(calfL);let calfR=calfL.clone();kneeR.add(calfR);
 let footL=new THREE.Mesh(new THREE.BoxGeometry(.105,.052,.22),shoe);footL.position.set(0,-.34,-.045);kneeL.add(footL);let footR=footL.clone();kneeR.add(footR);

 // clothing / damage accents only
 let shirtHem=box(bodyType===2?.27:.245,.025,.15,shirt,0,1.055,0,g);
 if(i%2===1){let gash=box(.065,.095,.008,wound,-.045,1.38,-.105,g);gash.rotation.z=.15}
 if(i%4===1){let tear=box(.050,.075,.007,wound,.065,1.50,-.108,g);tear.rotation.z=-.12}

 const marker=createLastZombieMarker();marker.position.set(0,2.56,0);marker.visible=false;g.add(marker);
 let safe=pushOutsideBuilding(x,z,.50);g.position.set(safe.x,0,safe.z);scene.add(g);

 const baseArmLX=.10+rnd()*.04,baseArmRX=.10+rnd()*.04,headLean=(rnd()-.5)*.035,gait=.82+rnd()*.12,bob=.002+rnd()*.003,
       limp=rnd()*.34,dragSide=limpSide,hunch=hunchBias,turnRate=2.0+rnd()*.6,lurch=.88+rnd()*.08,pauseClock=.35+rnd()*1.2,
       attackAnim=0,attackSide=rnd()>.5?1:-1,feral=.92+rnd()*.14,twitch=.22+rnd()*.45,snapBias=(rnd()-.5)*.03,snapRate=.96+rnd()*.5;

 let zz={g,head,torso,armL,armR,legL,legR,chest,stomach,pelvis,neck,jaw,marker,mouth,shoulderL,shoulderR,elbowL,elbowR,kneeL,kneeR,jacket,
   baseArmLX,baseArmRX,headLean,gait,bob,limp,dragSide,hunch,turnRate,lurch,shoulderDrop,pauseClock,attackAnim,attackSide,feral,
   twitch,snapBias,snapRate,nightmareType,armDrop,
   hp:d.hp,dead:false,speed:d.speed*(.96+rnd()*.09),attack:d.attack,damage:d.damage,strafe:d.strafe*.32,surge:d.surge,
   cool:0,groan:1+rnd()*3,step:.2+rnd()*.38,phase:rnd()*6.28,zig:rnd()>.5?1:-1,surgeT:.5+rnd()*2,stagger:0,staggerDir:1,
   leftArmHP:2,rightArmHP:2,legDamage:0,falling:false,corpseAge:0,fallDir:rnd()>.5?1:-1,fallAxis:rnd()>.55?"z":"x",fallSpeed:3.2+rnd()*2.1,
   role:(()=>{let r=rnd();if(wave<2)return "charger";if(wave<3)return r<.72?"charger":"flanker";if(wave<5)return r<.46?"charger":r<.72?"flanker":r<.90?"interceptor":"stalker";return r<.30?"charger":r<.56?"flanker":r<.80?"interceptor":"stalker"})(),
   side:i%2?1:-1,think:rnd()*.05,targetX:px,targetZ:pz,bravery:.75+rnd()*.5,groupOffset:(rnd()-.5)*5,groundY:0,stepL:0,stepR:Math.PI,strideScale:.95+rnd()*.12};

 if(nightmareType==="crawler"){
   g.scale.y*=.91;torso.position.y=1.11;pelvis.position.y=.72;neck.position.y=1.39;head.position.y=1.56;
   legL.position.set(-hipOffset,.67,.06);legR.position.set(hipOffset,.67,.06);legL.rotation.x=-1.00;legR.rotation.x=-.90;
   armL.position.set(-shoulderOffset,1.27,0);armR.position.set(shoulderOffset,1.27,0);armL.rotation.x=.88;armR.rotation.x=.88;g.rotation.x=-.055;
   zz.speed*=1.04;zz.hp=Math.max(2,Math.ceil(zz.hp*.92));zz.damage=Math.max(8,Math.round(zz.damage*.88));zz.hunch+=.10;zz.turnRate*=1.10;
 }
 if(nightmareType==="splitjaw"){jaw.position.y-=.035;jaw.position.x+=.022;jaw.rotation.x=.18;jaw.rotation.z=.06;let te