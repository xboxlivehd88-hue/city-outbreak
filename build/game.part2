function lamp(x,z,dir=1){
 const g=new THREE.Group();
 const pole=new THREE.Mesh(new THREE.CylinderGeometry(.07,.09,4.6,10),M(0x282d2d,.45));pole.position.y=2.3;g.add(pole);
 const arm=new THREE.Mesh(new THREE.CylinderGeometry(.045,.045,1.1,8),M(0x282d2d,.45));arm.rotation.z=Math.PI/2;arm.position.set(.48*dir,4.45,0);g.add(arm);
 const bulb=new THREE.Mesh(new THREE.SphereGeometry(.13,8,6),M(0xffd99a,.25));bulb.position.set(1*dir,4.45,0);g.add(bulb);
 const hood=box(.32,.08,.28,M(0x202526,.55),.98*dir,4.53,0,g);
 g.position.set(x,0,z);scene.add(g)
}
for(let z=-70;z<135;z+=28){lamp(-12,z,1);lamp(12,z+12,-1)}
let seed=73419;function rnd(){seed=(seed*1664525+1013904223)>>>0;return seed/4294967296}
let buildingId=0;
for(let side of [-1,1]){
  for(let z=-84;z<142;z+=14){
    if(z>16&&z<46)continue;
    let base=[0x555b5e,0x6c625b,0x4c565c,0x67645e][Math.floor(rnd()*4)];
    let w1=10+rnd()*6,h1=15+rnd()*27,d1=12+rnd()*6,x1=side*(21+rnd()*6);
    addBuilding(w1,h1,d1,x1,z,base,buildingId++);
    if(rnd()>.18){
      let w2=9+rnd()*5,h2=13+rnd()*24,d2=11+rnd()*5,x2=side*(37+rnd()*10);
      addBuilding(w2,h2,d2,x2,z+(rnd()-.5)*4,base,buildingId++);
    }
  }
}

function car(x,z,rot=0,type=0){
 const g=new THREE.Group(),body=[0x394b5c,0x6b2626,0x555753,0x2d3338,0x786d54][type%5];
 const long=type===2?5.4:type===3?5.0:4.5, high=type===1?1.05:.72;
 box(1.85,high,long,M(body,.55),0,.62,0,g);
 box(1.62,.62,long*.48,M(type===3?0xe2e2d8:body,.5),0,1.22,-.12,g);
 box(1.48,.38,.035,M(0x26353d,.18),0,1.28,-long*.25-.02,g).rotation.x=-.12;
 for(const sx of [-.92,.92])for(const sz of [-long*.31,long*.31]){
   const wh=new THREE.Mesh(new THREE.CylinderGeometry(.34,.34,.18,10),M(0x151515,.9));
   wh.rotation.z=Math.PI/2;wh.position.set(sx,.36,sz);g.add(wh)
 }
 
 // bumpers, windshield, rear glass and headlights
 box(1.58,.34,.04,M(0x23343c,.18),0,1.34,-long*.245,g).rotation.x=-.18;
 box(1.5,.30,.04,M(0x1d2c32,.2),0,1.31,long*.245,g).rotation.x=.15;
 box(1.72,.12,.12,M(0x1d2021,.5),0,.48,-long*.51,g);
 for(const hx of [-.58,.58])box(.32,.15,.04,M(0xe8d9a7,.22),hx,.69,-long*.505,g);
 for(const hx of [-.58,.58])box(.28,.13,.04,M(0x8c2020,.3),hx,.68,long*.505,g);
 g.position.set(x,0,z);g.rotation.y=rot;scene.add(g);
 return g
}
