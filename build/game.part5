)-(keys.a?1:0),len=Math.hypot(f,r)||1,moving=!!(f||r);if(moving){f/=len;r/=len;let sp=keys.shift?8:5,fx=-Math.sin(yaw),fz=-Math.cos(yaw),rx=Math.cos(yaw),rz=-Math.sin(yaw);let oldx=px,oldz=pz;px+=(fx*f+rx*r)*sp*dt;pz+=(fz*f+rz*r)*sp*dt;
for(const c of parkedCars){let dx=px-c.position.x,dz=pz-c.position.z;if(Math.hypot(dx,dz)<2.45){px=oldx;pz=oldz;break}}
let bp=slideBuilding(oldx,oldz,px,pz,.62);px=bp.x;pz=bp.z;
stepTimer-=dt;if(stepTimer<=0){stepS(keys.shift);stepTimer=keys.shift?.24:.38}}else stepTimer=0;playerVX=(px-lastPX)/Math.max(dt,.001);playerVZ=(pz-lastPZ)/Math.max(dt,.001);lastPX=px;lastPZ=pz;cam.position.set(px,1.65,pz);cam.rotation.order="YXZ";cam.rotation.y=yaw;cam.rotation.x=pitch;cam.rotation.z=0;recoil=Math.max(0,recoil-dt*1.35);gun.position.z=recoil*.42;gun.position.y=-recoil*.08;gun.rotation.x=recoil*2.05;for(let k of kits){if(k.used)continue;k.g.rotation.y+=dt*.8;if(Math.hypot(px-k.g.position.x,pz-k.g.position.z)<1.5&&health<100){k.used=true;scene.remove(k.g);health=Math.min(100,health+40);pickupS();ui();show("+40 HEALTH")}}}
function update(dt){
perfGuard(dt);capFX();
for(let i=thrown.length-1;i>=0;i--){let g=thrown[i];g.fuse-=dt;g.v.y-=8.5*dt;g.q.position.addScaledVector(g.v,dt);g.q.rotation.x+=dt*8;g.q.rotation.z+=dt*6;if(g.q.position.y<.12){g.q.position.y=.12;g.v.y*=-.38;g.v.x*=.76;g.v.z*=.76}if(g.fuse<=0){explodeGrenade(g);thrown.splice(i,1)}}
for(let i=casings.length-1;i>=0;i--){let c=casings[i];c.life-=dt;c.v.y-=4.5*dt;c.q.position.addScaledVector(c.v,dt);c.q.rotation.x+=c.spin*dt;c.q.rotation.z+=c.spin*.7*dt;if(c.q.position.y<.04){c.q.position.y=.04;c.v.y*=-.22;c.v.x*=.72;c.v.z*=.72}if(c.life<=0){scene.remove(c.q);casings.splice(i,1)}}
for(let i=impacts.length-1;i>=0;i--){let p=impacts[i];p.life-=dt;p.v.y-=3*dt;p.q.position.addScaledVector(p.v,dt);if(p.life<=0){scene.remove(p.q);impacts.splice(i,1)}}
for(let i=parts.length-1;i>=0;i--){let p=parts[i];p.life-=dt;p.v.y-=5*dt;p.q.position.addScaledVector(p.v,dt);
if(p.limb&&p.q.position.y<.08){p.q.position.y=.08;p.v.y*=-.22;p.v.x*=.7;p.v.z*=.7;p.q.rotation.x+=dt*5}
if(p.life<=0){scene.remove(p.q);parts.splice(i,1)}}if(dying){cam.rotation.z=Math.min(1.2,cam.rotation.z+dt*.5);cam.position.y=Math.max(.25,cam.position.y-dt*.55);return}if(!running)return;move(dt);if(between){return}for(let z of zombies){
 if(!z.dead)continue;
 z.corpseAge+=dt;
 if(z.falling){
   const target=z.fallDir*1.48,axis=z.fallAxis==="x"?"x":"z";
   z.g.rotation[axis]+=(target-z.g.rotation[axis])*Math.min(1,dt*z.fallSpeed);
   z.g.position.y=Math.max(-.18,z.g.position.y-dt*.28);
   z.g.position.x+=Math.sin(z.g.rotation.y)*dt*.12;
   z.g.position.z+=Math.cos(z.g.rotation.y)*dt*.12;
   if(Math.abs(z.g.rotation[axis]-target)<.035)z.falling=false;
 }
 if(z.corpseAge>8&&z.g.parent)scene.remove(z.g);
}
const active=living();
const highlightLast=active.length<=5;
for(let z of active){
 if(!Number.isFinite(z.g.position.x)||!Number.isFinite(z.g.position.y)||!Number.isFinite(z.g.position.z)){
   const a=rnd()*Math.PI*2,dist=16+rnd()*8;let safe=pushOutsideBuilding(px+Math.sin(a)*dist,pz+Math.cos(a)*dist,.85);
   z.g.position.set(safe.x,0,safe.z);z.targetX=px;z.targetZ=pz;z.stagger=.25;
 }
 if(z.marker){
   z.marker.visible=highlightLast;
   const pulse=1+.14*Math.sin(last*.01+z.phase*2.2);
   z.marker.scale.set(1.35*pulse,1.35*pulse,1);
 }

z.cool=Math.max(0,z.cool-dt);z.stagger=Math.max(0,(z.stagger||0)-dt);z.attackAnim=Math.max(0,z.attackAnim-dt);
z.groan-=dt;z.step-=dt;z.surgeT-=dt;z.pauseClock-=dt;
let animRate=(1.65+z.speed*.55)*(1-z.legDamage*.06);z.phase+=dt*animRate;
if(z.pauseClock<=0){z.pauseClock=1.1+rnd()*3.2;if(rnd()<.22)z.stagger=Math.max(z.stagger,.10+rnd()*.12)}
if(z.surgeT<=0){z.surgeT=.65+rnd()*1.7;z.zig*=-1}z.think-=dt;
const playerDistToZombie=Math.hypot(px-z.g.position.x,pz-z.g.position.z);
if(z.think<=0){
 z.think=.08+rnd()*.10;
 const speed=Math.hypot(playerVX,playerVZ),lead=Math.min(1.5,speed*.14);
 let tx=px, tz=pz;

 // Roles now modify pursuit instead of replacing interest in the player.
 if(z.role==="interceptor"){
   tx=px+playerVX*lead*.75;tz=pz+playerVZ*lead*.75;
 }
 if(z.role==="flanker"&&playerDistToZombie>5){
   const pd=playerDistToZombie||1;
   const nx=(px-z.g.position.x)/pd,nz=(pz-z.g.position.z)/pd;
   const off=Math.min(2.8,1.4+playerDistToZombie*.055);
   tx=px+(-nz)*z.side*off;
   tz=pz+(nx)*z.side*off;
 }
 if(z.role==="stalker"){
   // stalkers still close distance and never park in place while the player is nearby
   tx=px+playerVX*lead*.28;tz=pz+playerVZ*lead*.28;
 }
 if(z.role==="charger"){
   tx=px+playerVX*lead*.18;tz=pz+playerVZ*lead*.18;
 }

 // Keep every role strongly biased toward the player.
 tx=px+(tx-px)*.42;
 tz=pz+(tz-pz)*.42;
 if(playerDistToZombie<6||active.length<=2){tx=px;tz=pz;}
 z.targetX=tx;z.targetZ=tz;
}
let dx=z.targetX-z.g.position.x,dz=z.targetZ-z.g.position.z,d=playerDistToZombie||.001;
let td=Math.hypot(dx,dz)||.001;
const wantedYaw=Math.atan2(dx,dz)+Math.PI;
 const turnDelta=Math.atan2(Math.sin(wantedYaw-z.g.rotation.y),Math.cos(wantedYaw-z.g.rotation.y));
 z.g.rotation.y+=turnDelta*Math.min(1,dt*z.turnRate);
 const playerYaw=Math.atan2(px-z.g.position.x,pz-z.g.position.z)+Math.PI;
 const lookDelta=Math.atan2(Math.sin(playerYaw-z.g.rotation.y),Math.cos(playerYaw-z.g.rotation.y));
 const playerLook=Math.max(-.42,Math.min(.42,lookDelta));

 const walk=Math.sin(z.phase*z.gait),
       walk2=Math.sin(z.phase*z.gait+Math.PI),
       attack=z.attackAnim>0?Math.sin((.62-z.attackAnim)/.62*Math.PI):0,
       claw=z.attackSide||1,drag=z.dragSide,
       limpL=drag<0?1-z.limp*.24:1,limpR=drag>0?1-z.limp*.24:1,
       rootSway=walk*(.006+z.limp*.004),shoulderLead=turnDelta*.08,
       twitchPulse=Math.sin(last*.0018*z.snapRate+z.twitch),twitchKick=(twitchPulse>.985?(twitchPulse-.985)*.50:0),
       headSnap=Math.sin(last*.0018*z.snapRate+z.twitch*1.08)*z.snapBias,
       isCrawler=z.nightmareType==="crawler",isBrute=z.nightmareType==="brute",isTwitch=z.nightmareType==="twitch";

 // SurrounDead-style read: human silhouette, subtle body motion, no hover bob.
 z.torso.rotation.x=z.hunch + .03 - attack*.08;
 z.torso.rotation.z=z.shoulderDrop + rootSway*.18;
 z.torso.rotation.y=walk*.010 + shoulderLead*.10;
 if(z.jacket){z.jacket.rotation.x=z.torso.rotation.x*.35;z.jacket.rotation.z=z.torso.rotation.z*.6;z.jacket.rotation.y=z.torso.rotation.y*.8}
 if(z.pelvis){z.pelvis.rotation.y=-walk*.016;z.pelvis.rotation.z=-rootSway*.10;z.pelvis.rotation.x=-.02}
 if(z.neck){z.neck.rotation.z=z.headLean*.05;z.neck.rotation.x=attack*.015}
 if(z.jaw){z.jaw.rotation.x=.03+attack*.10+Math.abs(Math.sin(z.phase*.22))*.005}
 z.head.rotation.x=.01+Math.abs(walk)*.006-attack*.08+twitchKick*.010;
 z.head.rotation.z=z.headLean+Math.sin(z.phase*.30)*.005+headSnap*.03;
 z.head.rotation.y=Math.sin(z.phase*.24)*.008+attack*.03*claw+playerLook*.42;

 // Upper body sway stays restrained.
 z.armL.rotation.x=z.baseArmLX+walk*.05+attack*(claw<0?.22:.10);
 z.armR.rotation.x=z.baseArmRX+walk2*.05+attack*(claw>0?.22:.10);
 z.armL.rotation.z=-.12+walk2*.010+((drag<0)?-.018-z.armDrop*.04:0);
 z.armR.rotation.z=.12-walk2*.010+((drag>0)?.018+z.armDrop*.04:0);
 if(z.elbowL)z.elbowL.rotation.x=.18+Math.max(0,walk)*.10+attack*(claw<0?.24:.08);
 if(z.elbowR)z.elbowR.rotation.x=.18+Math.max(0,walk2)*.10+attack*(claw>0?.24:.08);

 // Proper shamble: legs drive the motion and the body dips slightly instead of hovering.
 z.legL.rotation.x=walk2*.18*z.strideScale*limpL-attack*.02;
 z.legR.rotation.x=walk*.18*z.strideScale*limpR-attack*.02;
 z.legL.rotation.z=-rootSway*.035; z.legR.rotation.z=rootSway*.035;
 if(z.kneeL)z.kneeL.rotation.x=.04+Math.max(0,-walk2)*.28+(drag<0?z.limp*.04:0);
 if(z.kneeR)z.kneeR.rotation.x=.04+Math.max(0,-walk)*.28+(drag>0?z.limp*.04:0);

 // Keep the root grounded. Use only a tiny weight-shift drop.
 if(isCrawler){
   z.torso.rotation.x=.26+Math.abs(walk)*.02-attack*.04;
   z.head.rotation.x=-.05-attack*.04;
   z.armL.rotation.x=.88+walk*.16+attack*.18;z.armR.rotation.x=.88+walk2*.16+attack*.18;
   z.legL.rotation.x=-.90+walk2*.04;z.legR.rotation.x=-.84+walk*.04;
   z.g.position.y=z.groundY+.004;
 }else if(isBrute){
   z.g.position.y=z.groundY + Math.max(0,-walk)*z.bob*.20;
   z.armL.rotation.x+=walk*.02; z.armR.rotation.x+=walk2*.02;
 }else{
   z.g.position.y=z.groundY + (Math.max(0,-walk)+Math.max(0,-walk2))*z.bob*.18 + twitchKick*(isTwitch?.008:.002);
 }
 if(isTwitch){z.head.rotation.y+=twitchKick*.02;z.head.rotation.z+=twitchKick*(Math.sin(last*.013)>0?.018:-.018)}

 const attackRange=z.nightmareType==="brute"?1.30:z.nightmareType==="crawler"?1.06:1.00;
 if(d>attackRange){let nx=dx/td,nz=dz/td,sx=-nz,sz=nx;
 let sepX=0,sepZ=0;
 for(const o of active){if(o===z)continue;let ox=z.g.position.x-o.g.position.x,oz=z.g.position.z-o.g.position.z,od=Math.hypot(ox,oz);if(od>0&&od<1.65){sepX+=ox/od*(1.65-od);sepZ+=oz/od*(1.65-od)}}
 nx+=sepX*.55;nz+=sepZ*.55;
 let nl=Math.hypot(nx,nz)||1;nx/=nl;nz/=nl;
 let zig=Math.sin(z.phase*.55)*z.strafe*z.zig*.28,
 surge=1+(Math.sin(z.phase*1.35)>.72?z.surge*0.6:0),
 shamble=(z.nightmareType==="twitch"?1.00:z.nightmareType==="brute"?.74:z.nightmareType==="crawler"?.90:.84)
          +Math.max(0,Math.sin(z.phase*z.gait))*(z.nightmareType==="twitch"?.22:.14)*z.lurch,
 stun=z.stagger>0?.16:1,
 limpSlow=Math.max(.42,1-z.legDamage*.18-z.limp*.08);
 let ox=z.g.position.x,oz=z.g.position.z;
let stepX=(nx+sx*zig)*z.speed*surge*shamble*stun*limpSlow*dt,stepZ=(nz+sz*zig)*z.speed*surge*shamble*stun*limpSlow*dt;
let moveLen=Math.hypot(stepX,stepZ);
z.phase += moveLen*3.8;
let zp=slideBuilding(ox,oz,ox+stepX,oz+stepZ,.50);z.g.position.x=zp.x;z.g.position.z=zp.z;
for(const c of parkedCars){if(Math.hypot(z.g.position.x-c.position.x,z.g.position.z-c.position.z)<2.15){let cp=slideBuilding(ox,oz,ox+sx*z.side*z.speed*dt,oz+sz*z.side*z.speed*dt,.50);z.g.position.x=cp.x;z.g.position.z=cp.z;break}}if(z.stagger>0){z.torso.rotation.z+=z.staggerDir*.24;z.g.position.x-=nx*.7*dt;z.g.position.z-=nz*.7*dt;}if(z.step<=0&&d<14){zStep(Math.max(.018,.10*(1-d/16)));z.step=Math.max(.34,.62-z.speed*.035+rnd()*.18)}}else if(z.cool<=0){
 bite(z)
}if(z.groan<=0&&d<30){groan(Math.max(.025,.19*(1-d/32)));z.groan=Math.max(.8,1.7-wave*.04)+rnd()*2.8}}if(active.length===0)beginBreak();ui()}
let perfTick=0;
cv.addEventListener("webglcontextlost",e=>{e.preventDefault();console.error("CITY OUTBREAK: WebGL context lost");show("GRAPHICS RESET — REFRESH IF NEEDED")});
function perfGuard(dt){
 perfTick+=dt;
 if(perfTick>3){perfTick=0;console.log("CityOutbreak perf",{zombies:living().length,parts:parts.length,impacts:impacts.length,casings:casings.length,renderer:ren.info.render});}
}
function resize(){ren.setSize(innerWidth,innerHeight,false);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()}addEventListener("resize",resize);resize();
function frame(t){let dt=Math.min(.04,(t-last)/1000);last=t;update(dt);ren.render(scene,cam);requestAnimationFrame(frame)}requestAnimationFrame(frame);
function reset(){initAudio();stopAuto();clearKeys();for(let z of zombies)scene.remove(z.g);zombies=[];for(let p of parts)scene.remove(p.q);parts=[];for(let c of casings)scene.remove(c.q);casings=[];for(let g of thrown)scene.remove(g.q);thrown.length=0;for(let p of impacts)scene.remove(p.q);impacts=[];for(let k of kits){if(k.used){scene.add(k.g);k.used=false}}px=0;pz=-15;yaw=0;pitch=0;health=100;kills=0;heads=0;cash=0;wave=1;weapon="rifle";magSize=12;damageLevel=1;reloadLevel=0;unlocked={rifle:true,smg:false,shotgun:false,pistol:false,dmr:false};ammoState={rifle:{mag:12,reserve:72},smg:{mag:30,reserve:90},shotgun:{mag:6,reserve:30},pistol:{mag:15,reserve:60},dmr:{mag:10,reserve:30}};grenades=2;nukes=0;nukeInProgress=false;rebuildGun();dying=false;between=false;reloading=false;death.classList.remove("show");announce.classList.remove("show");shop.classList.remove("show");startScreen.style.display="none";running=true;spawnWave();ui();cv.focus();if(document.pointerLockElement!==cv){try{cv.requestPointerLock?.()}catch(_){}}}
rebuildGun();document.querySelector("#start").onclick=reset;document.querySelector("#restart").onclick=reset;
addEventListener("keydown",e=>{let k=e.key.toLowerCase();if(k in keys)keys[k]=true;if(k==="r"&&!e.repeat)reload();if(k==="g"&&!e.repeat)throwGrenade();if(k==="n"&&!e.repeat)detonateNuke();if(k==="1")setWeapon("rifle");if(k==="2")setWeapon("smg");if(k==="3")setWeapon("shotgun");if(k==="4")setWeapon("pistol");if(k==="5")setWeapon("dmr");if(["w","a","s","d","r","g","n","1","2","3","4","5","shift"].includes(k))e.preventDefault()});
addEventListener("keyup",e=>{let k=e.key.toLowerCase();if(k in keys)keys[k]=false});addEventListener("blur",()=>{clearKeys();stopAuto()});document.addEventListener("visibilitychange",()=>{if(document.hidden){clearKeys();stopAuto()}});
document.addEventListener("pointerlockchange",()=>{
 if(document.pointerLockElement!==cv){
   stopAuto();
   if(between){document.body.style.cursor="default";shop.style.cursor="default"}
   else if(running&&!dying)show("CLICK GAME TO LOCK AIM");
 }else{
   document.body.style.cursor="";
   if(running&&!between&&!dying)show("AIM LOCKED");
 }
});
document.addEventListener("mousemove",e=>{if(document.pointerLockElement===cv){yaw-=e.movementX*lookSensitivity;pitch-=e.movementY*lookSensitivity*.9;pitch=Math.max(-1.05,Math.min(1.05,pitch));aimX=0;aimY=0;}});
cv.addEventListener("pointerdown",e=>{if(e.button===0){cv.focus();if(document.pointerLockElement!==cv){cv.requestPointerLock?.();e.preventDefault();return}triggerDown();e.preventDefault()}});
addEventListener("pointerup",e=>{if(e.button===0)triggerUp()});
cv.addEventListener("pointercancel",triggerUp);
cv.addEventListener("contextmenu",e=>e.preventDefault());
ui();

let runtimeErrorShown=false;
addEventListener("error",e=>{
 if(runtimeErrorShown)return;runtimeErrorShown=true;
 const d=document.createElement("div");
 d.style.cssText="position:fixed;left:12px;bottom:12px;z-index:99999;background:rgba(120,0,0,.92);color:white;padding:10px 12px;font:13px monospace;max-width:70vw;border:1px solid #fff";
 d.textContent="GAME ERROR: "+(e.message||"unknown error");
 document.body.appendChild(d);
 console.error("City Outbreak runtime error",e.error||e.message);
});

</script>
</body>
</html>