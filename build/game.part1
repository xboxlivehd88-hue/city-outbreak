<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>City Outbreak Enhanced</title>
<style>
html,body{margin:0;background:#111;color:#fff;font-family:Arial,sans-serif;height:100%;overflow:hidden}
#game{position:relative;width:100%;height:100%}
canvas{display:block;width:100%;height:100%;cursor:none}
.hud{position:absolute;left:16px;top:16px;background:#000b;padding:12px;border-radius:10px;font-size:14px;pointer-events:none}
.stats{position:absolute;right:16px;top:16px;background:#000b;padding:12px;border-radius:10px;text-align:right;pointer-events:none}
.track{width:200px;height:16px;background:#222;border:1px solid #888;border-radius:10px;overflow:hidden;margin:5px 0 8px}
#healthBar{height:100%;width:100%;background:#55a45c}
#crosshair{position:absolute;left:50%;top:50%;width:26px;height:26px;transform:translate(-50%,-50%);pointer-events:none}
#crosshair:before,#crosshair:after{content:"";position:absolute;background:white;box-shadow:0 0 3px #000}
#crosshair:before{width:26px;height:2px;top:12px}
#crosshair:after{width:2px;height:26px;left:12px}#hitmarker{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(.65);font:900 34px Arial;color:#fff;opacity:0;pointer-events:none;text-shadow:0 0 4px #000;transition:opacity .05s,transform .05s}#hitmarker.show{opacity:1;transform:translate(-50%,-50%) scale(1)}#hitmarker.head{color:#ffd36a;font-size:42px}
#announce,#death{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;pointer-events:none;opacity:0;text-shadow:0 3px 10px #000}
#announce.show{opacity:1} #announce b{font-size:64px} #announce span{font-size:22px;font-weight:bold}
#death{font-size:54px;font-weight:900;letter-spacing:8px;background:#2000;transition:1.5s}
#death.show{opacity:1;background:#200d}
#damage{position:absolute;inset:0;background:radial-gradient(circle,transparent 30%,#800b);opacity:0;pointer-events:none}
#damage.show{opacity:1}
#nukeFlash{position:absolute;inset:0;background:white;opacity:0;pointer-events:none;z-index:20}
#nukeFlash.boom{animation:nukeFlash .95s ease-out}
#nukeShock{position:absolute;left:50%;top:50%;width:20px;height:20px;border:8px solid #fff;border-radius:50%;transform:translate(-50%,-50%) scale(.1);opacity:0;pointer-events:none;z-index:19;box-shadow:0 0 35px #ffb347,0 0 90px #ff7a00}
#nukeShock.boom{animation:nukeShock .9s ease-out}
@keyframes nukeFlash{0%{opacity:0}8%{opacity:1}28%{opacity:.92}100%{opacity:0}}
@keyframes nukeShock{0%{opacity:1;transform:translate(-50%,-50%) scale(.1)}100%{opacity:0;transform:translate(-50%,-50%) scale(65)}}
#msg{position:absolute;bottom:10%;left:50%;transform:translateX(-50%);background:#000c;padding:8px 14px;border-radius:8px;opacity:0;pointer-events:none}
#msg.show{opacity:1}
#shop{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:4;display:none;background:#080a0bea;border:1px solid #777;border-radius:14px;padding:18px;text-align:center;min-width:310px}#shop.show{display:block}#shop h2{margin:0 0 8px}#shop button{display:block;width:100%;font-size:14px;margin:7px 0;padding:9px}#shop p{font-size:12px;color:#ccc;margin-bottom:0}#shop .readyBtn{margin-top:14px;font-weight:900;font-size:16px;background:#e8e8e8;color:#111}#startScreen{position:absolute;inset:0;background:#111e;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;z-index:5}
button{font-size:18px;padding:12px 20px;border:0;border-radius:9px;cursor:pointer;margin:6px}
.small{font-size:13px;color:#ddd;line-height:1.5}
</style>
</head>
<body>
<div id="game">
<canvas id="cv" tabindex="0"></canvas>
<div class="hud"><b>HEALTH <span id="healthText">100</span></b><div class="track"><div id="healthBar"></div></div>
WASD — Move<br>Shift — Sprint<br>Mouse — Aim + Look<br>Click — Single Shot<br>Hold Click — Full Auto<br>R — Reload<br>1/2/3/4/5 — Weapons<br>G — Throw Grenade<br>N — Deploy Tactical Nuke<br><b>Headshot = instant kill</b></div>
<div class="stats"><span id="ammo">12 / 72</span><br><span id="kills">KILLS 0</span><br><span id="heads">HEADSHOTS 0</span><br><span id="wave">WAVE 1</span><br><span id="remaining">ZOMBIES 6</span><br><span id="cash">CASH $0</span><br><span id="weaponName">RIFLE</span><br><span id="grenadeCount">GRENADES 2</span><br><span id="nukeCount">NUKES 0</span></div>
<div id="crosshair"></div><div id="hitmarker">×</div><div id="damage"></div><div id="nukeFlash"></div><div id="nukeShock"></div>
<div id="announce"><b id="big"></b><span id="small"></span></div>
<div id="death">YOU DIED</div><div id="msg"></div>
<div id="shop"><h2>WAVE SHOP</h2><div id="shopCash">CASH $0</div>
    <button data-buy="rifleAmmo">Rifle Ammo +36 — $120</button>
<button data-buy="smgAmmo">SMG Ammo +60 — $110</button>
<button data-buy="shotgunAmmo">Shotgun Shells +18 — $140</button>
<button data-buy="pistolAmmo">Pistol Ammo +48 — $90</button>
<button data-buy="dmrAmmo">DMR Ammo +24 — $160</button>
    <button data-buy="heal">Heal +40 — $150</button>
    <button data-buy="mag">Magazine +4 — $250</button>
    <button data-buy="damage">Damage Upgrade — $350</button>
    <button data-buy="reload">Faster Reload — $300</button>
    <button data-buy="smg">Unlock SMG — $500</button>
    <button data-buy="shotgun">Unlock Shotgun — $700</button>
<button data-buy="pistol">Unlock Pistol — $300</button>
<button data-buy="dmr">Unlock DMR — $900</button>
    <button data-buy="grenade">Grenade — $175</button>
    <button data-buy="nuke">TACTICAL NUKE — $100 (TEST)</button>
    <button id="readyNext" class="readyBtn">READY — START NEXT WAVE</button>
    <p>Take your time. The next wave will not start until you press Ready.</p></div><div id="startScreen"><h1>CITY OUTBREAK</h1><p>Survive increasingly aggressive zombie waves with improved weapon feedback.</p><button id="start">START OUTBREAK</button><button id="restart">RESTART</button><p class="small">WASD move • Shift sprint • Locked center crosshair • Mouse look • Click = single shot • Hold click = full auto • R reload<br>ENHANCED BUILD: optimized combat, improved tactical roles, car collision/avoidance, varied death falls and upgraded atmosphere<br>Zombie AI uses chargers, flankers, interceptors and stalkers that predict movement, spread out and surround you<br>Zombies collapse when killed, stay as corpses, can lose arms, and limp after leg damage<br>Graphics upgrade: textured brick/window building facades, rooftop detail, solid building collision, improved lighting/shadows and upgraded vehicles<br>Parked sedans, SUVs, pickups and vans now fill the streets<br>PISTOL PURCHASE FIXED • weapon unlock state now initializes correctly<br>Center-locked FPS aiming added • crosshair now stays centered while the camera follows the mouse<br>Zombie spawns are checked against buildings/cars, so they should appear in open streets and alleys instead of inside structures<br>FREEZE FIX: shared audio buffers, explicit audio cleanup, much lower FX buildup, dead-body shadow shutdown and shorter corpse lifetime<br>STABILITY FIX: hit effects reuse GPU resources, FX are capped, zombie shadow cost is reduced, and invalid positions self-recover<br>SURROUNDEAD DEEP-DIVE PASS: flatter human faces, cleaner outer clothing silhouettes, grounded shambling locomotion, reduced hover-bob, and walk cycles tied more closely to real movement<br>ZOMBIE BASE MESH REPLACED: one tapered human torso, articulated elbows/knees, flat facial features and a visibly different low-poly human silhouette<br>SURROUNDEAD-INSPIRED PASS: simpler low-poly human silhouettes, cleaner anatomy, less assembled-part look, and zombies that read as people first<br>HUMAN FIXUP PASS 4: less broken-looking joints, more natural arm hang, fuller legs, cleaner faces and smoother shambling motion<br>HUMAN REALISM PASS 3: cleaner body taper, more human facial planes, better wrists/hands, layered clothing and more grounded weight-shifting walks<br>HUMAN PROPORTION FIX: zombies now use much cleaner human silhouettes, narrower shoulders, longer limbs, smaller hands and less blob-like bodies<br>Zombie realism pass: less fantasy deformation, more believable anatomy, decay, torn clothing, asymmetry and human-looking injury<br>Savage zombie pass: nastier face damage, exposed bone/flesh, deeper torso wounds, limb tears and more aggressive attack lunges/mauls<br>Major zombie redesign: rounder body shapes, layered chest/hips, improved arms and legs, head/neck/jaw detail, and more lifelike shambling animation<br>Realism pass: guns now use firearm-like receivers, stocks, magazines, barrels, rails, sights, optics and controls<br>Five weapons have separate magazines/reserve ammo: rifle, SMG, shotgun, pistol and DMR<br>Shop sells every ammo type separately • upgraded procedural gun models include barrels, sights, stocks, magazines, rails and optics<br>G throws a timed grenade with area damage • buy more grenades in the shop<br>N deploys a Tactical Nuke during a wave • Tactical Nukes are shop-only and cost $100 for testing<br>Shop opens automatically after every wave • mouse cursor is released for upgrades • Ready locks aim again<br>Improved recoil • shell casings • hit markers • zombie stagger • impact effects<br>Sound begins after clicking Start.</p></div>
</div>
<script type="module">
import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.180.0/+esm";
const cv=document.querySelector("#cv"),cross=document.querySelector("#crosshair"),healthText=document.querySelector("#healthText"),healthBar=document.querySelector("#healthBar"),ammoEl=document.querySelector("#ammo"),killsEl=document.querySelector("#kills"),headsEl=document.querySelector("#heads"),waveEl=document.querySelector("#wave"),remainingEl=document.querySelector("#remaining"),cashEl=document.querySelector("#cash"),weaponNameEl=document.querySelector("#weaponName"),grenadeEl=document.querySelector("#grenadeCount"),nukeEl=document.querySelector("#nukeCount"),nukeFlash=document.querySelector("#nukeFlash"),nukeShock=document.querySelector("#nukeShock"),shop=document.querySelector("#shop"),shopCash=document.querySelector("#shopCash"),damage=document.querySelector("#damage"),hitmarker=document.querySelector("#hitmarker"),announce=document.querySelector("#announce"),big=document.querySelector("#big"),small=document.querySelector("#small"),death=document.querySelector("#death"),msg=document.querySelector("#msg"),startScreen=document.querySelector("#startScreen");
let ac,master,audioOn=false,noiseBuffer=null;
function initAudio(){
 if(!ac){
   ac=new AudioContext();master=ac.createGain();master.gain.value=.4;master.connect(ac.destination);
   noiseBuffer=ac.createBuffer(1,Math.floor(ac.sampleRate*1.2),ac.sampleRate);
   const a=noiseBuffer.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=Math.random()*2-1;
 }
 ac.resume();audioOn=true
}
function tone(f,d,type="sine",v=.1,delay=0){
 if(!audioOn)return;let t=ac.currentTime+delay,o=ac.createOscillator(),g=ac.createGain();
 o.type=type;o.frequency.value=f;g.gain.setValueAtTime(Math.max(.001,v),t);g.gain.exponentialRampToValueAtTime(.001,t+d);
 o.connect(g);g.connect(master);o.onended=()=>{try{o.disconnect();g.disconnect()}catch(_){}};o.start(t);o.stop(t+d+.01)
}
function noise(d=.1,v=.15,cut=500){
 if(!audioOn||!noiseBuffer)return;let s=ac.createBufferSource(),f=ac.createBiquadFilter(),g=ac.createGain(),t=ac.currentTime;
 s.buffer=noiseBuffer;f.type="lowpass";f.frequency.value=cut;g.gain.setValueAtTime(Math.max(.001,v),t);g.gain.exponentialRampToValueAtTime(.001,t+d);
 s.connect(f);f.connect(g);g.connect(master);
 s.onended=()=>{try{s.disconnect();f.disconnect();g.disconnect()}catch(_){}};
 const maxOff=Math.max(0,noiseBuffer.duration-d-.02);s.start(t,Math.random()*maxOff,Math.min(d,noiseBuffer.duration));s.stop(t+d+.02)
}
const gunS=()=>{noise(.1,.65,2600);tone(88,.14,"square",.28);tone(48,.2,"sine",.17,.02)},stepS=r=>{noise(.07,r?.16:.11,220);tone(r?105:85,.045,"sine",.055)},zStep=v=>{noise(.075,v*.85,130);tone(58,.05,"sine",v*.45)},biteS=()=>{noise(.16,.31,390);tone(92,.14,"sawtooth",.16)},headS=()=>{noise(.22,.48,650);tone(72,.16,"sawtooth",.18)},reloadS=()=>{tone(620,.04,"square",.1);setTimeout(()=>tone(390,.05,"square",.11),250);setTimeout(()=>tone(720,.04,"square",.1),600)},pickupS=()=>{tone(520,.08,"sine",.13);tone(760,.1,"sine",.14,.09)};
function groan(v){
 if(!audioOn)return;let o=ac.createOscillator(),g=ac.createGain(),f=ac.createBiquadFilter(),t=ac.currentTime;
 o.type="sawtooth";o.frequency.setValueAtTime(70+Math.random()*30,t);o.frequency.exponentialRampToValueAtTime(40+Math.random()*18,t+.55);
 f.type="lowpass";f.frequency.value=190;g.gain.setValueAtTime(Math.max(.001,v),t);g.gain.exponentialRampToValueAtTime(.001,t+.58);
 o.connect(f);f.connect(g);g.connect(master);o.onended=()=>{try{o.disconnect();f.disconnect();g.disconnect()}catch(_){}};
 o.start(t);o.stop(t+.60)
}
const scene=new THREE.Scene();scene.background=new THREE.Color(0x89999a);scene.fog=new THREE.FogExp2(0x89999a,.0052);
const cam=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.08,220),ren=new THREE.WebGLRenderer({canvas:cv,antialias:true});ren.setPixelRatio(Math.min(devicePixelRatio,1.45));ren.shadowMap.enabled=true;ren.shadowMap.type=THREE.PCFSoftShadowMap;ren.toneMapping=THREE.ACESFilmicToneMapping;ren.toneMappingExposure=1.42;
scene.add(new THREE.HemisphereLight(0xcbd9dc,0x596158,1.75));let sun=new THREE.DirectionalLight(0xffe5bd,3.15);sun.position.set(-35,48,-25);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);sun.shadow.camera.left=-70;sun.shadow.camera.right=70;sun.shadow.camera.top=70;sun.shadow.camera.bottom=-70;scene.add(sun);
const M=(c,r=.82)=>new THREE.MeshStandardMaterial({color:c,roughness:r});
function box(w,h,d,m,x,y,z,p=scene){let q=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);q.position.set(x,y,z);q.castShadow=true;q.receiveShadow=true;p.add(q);return q}

function taperedPrism(topW,bottomW,h,topD,bottomD,m,x,y,z,p=scene){
 const tw=topW/2,bw=bottomW/2,td=topD/2,bd=bottomD/2,hh=h/2;
 const pos=new Float32Array([
   -bw,-hh,-bd, bw,-hh,-bd, bw,-hh,bd, -bw,-hh,bd,
   -tw, hh,-td, tw, hh,-td, tw, hh,td, -tw, hh,td
 ]);
 const idx=[0,1